

// Jenkinsfile - Continuous Integration pipeline
// Phase 2, Task 2: triggered on PRs and pushes; install deps, run tests,
// code quality checks, build the Docker artifact.

pipeline {
    agent any

    environment {
        APP_DIR          = "app"
        IMAGE_NAME        = "task-api"
        REGISTRY          = "us-central1-docker.pkg.dev/project-fd904717-6ef9-4872-ad5/capstone-repo"
        IMAGE_TAG         = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements-dev.txt
                    '''
                }
            }
        }

        stage('Run unit tests') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        . venv/bin/activate
                        pytest -v --junitxml=test-results.xml
                    '''
                }
            }
            post {
                always {
                    junit "${APP_DIR}/test-results.xml"
                }
            }
        }

        stage('Code quality checks') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        . venv/bin/activate
                        flake8 main.py --max-line-length=100 --exit-zero
                    '''
                }
            }
        }

        stage('Build artifact (Docker image)') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        docker build -t ${IMAGE_NAME}:${IMAGE_TAG} .
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                        docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${REGISTRY}/${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        stage('Push to Artifact Registry') {
            steps {
                sh '''
                    gcloud auth configure-docker us-central1-docker.pkg.dev --quiet
                    docker push ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}
                    docker push ${REGISTRY}/${IMAGE_NAME}:latest
                '''
            }
        }
    }

    post {
        success {
            echo "CI pipeline succeeded - image pushed as ${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "CI pipeline failed - check the stage logs above."
        }
    }
}
